# Copy to .env and fill in. Every value marked REQUIRED has no safe default.

# --- Stage 1: stack ---
# REQUIRED: a 4.x release tag from https://github.com/wazuh/wazuh-docker/releases (e.g. v4.x.y). Use the latest 4.x.
WAZUH_VERSION=
# REQUIRED: Suricata image tag from https://hub.docker.com/r/jasonish/suricata/tags (e.g. 7.0 or 8.0).
SURICATA_TAG=
# REQUIRED: Juice Shop tag from https://hub.docker.com/r/bkimminich/juice-shop/tags (a numbered release, not latest).
JUICE_TAG=

# Wazuh indexer (OpenSearch). wazuh-docker ships admin / SecretPassword — CHANGE IT (README step 1.4).
INDEXER_URL=https://127.0.0.1:9200
INDEXER_USER=admin
INDEXER_PASS=
# Root CA generated by wazuh-docker's cert generator (bootstrap.sh prints the exact path).
INDEXER_CA=./wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/root-ca.pem

# --- Command-center API (serves the dashboard) ---
CC_BIND=127.0.0.1
CC_PORT=8088

# --- Stage 2: triage agent ---
ANTHROPIC_API_KEY=
CC_MODEL=claude-sonnet-5-5
TRIAGE_MIN_LEVEL=10
TRIAGE_LOOKBACK_MIN=30
TRIAGE_MAX_PER_RUN=10
