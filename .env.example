# Copy to .env (chmod 600). Never commit .env. Values marked REQUIRED have no safe default.
# Secrets left EMPTY are generated by scripts/bootstrap.sh (scripts/gen_secrets.py) before Wazuh's first boot,
# so upstream's published default passwords are never live.

# --- Stage 1: versions (pinned; verified working together on 2026-11-25, see HANDOFF.md) ---
# https://github.com/wazuh/wazuh-docker/tags  (4.x only)
WAZUH_VERSION=v4.14.11
# https://hub.docker.com/r/jasonish/suricata/tags  (a full x.y.z tag, not 8.0 or latest)
SURICATA_TAG=8.0.8
# https://hub.docker.com/r/bkimminich/juice-shop/tags  (a numbered release, not latest)
JUICE_TAG=v20.4.0

# --- Wazuh credentials (generated if empty) ---
WAZUH_ADMIN_PASS=
WAZUH_KIBANASERVER_PASS=
WAZUH_API_PASS=
# Bind address for the Wazuh dashboard (https on :443). Default loopback; set your LAN IP to expose ONLY the UI.
WAZUH_DASHBOARD_BIND=127.0.0.1

# --- Indexer access for the CC API and triage agent: read-only user, never admin ---
# TLS is verified against the generated root CA AND the cert name. The cert is issued for "wazuh.indexer", so the URL
# uses that name and INDEXER_CONNECT pins where to connect (like curl --resolve). No proxy is used for this connection.
INDEXER_URL=https://wazuh.indexer:9200
INDEXER_CONNECT=127.0.0.1
INDEXER_USER=cc_reader
INDEXER_PASS=
INDEXER_CA=./wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/root-ca.pem

# --- Command-center API (serves the dashboard) ---
CC_BIND=127.0.0.1
CC_PORT=8088

# --- Stage 2: triage agent ---
ANTHROPIC_API_KEY=
CC_MODEL=claude-sonnet-5-5
TRIAGE_MIN_LEVEL=10
TRIAGE_LOOKBACK_MIN=30
TRIAGE_MAX_PER_RUN=10
